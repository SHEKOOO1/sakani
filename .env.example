DATABASE_URL=dorm_system.db
DB_CLIENT=mssql

# ==== Database (قيم التطوير المحلي فقط — DEVELOPMENT ONLY) ====
# ⚠️ في الإنتاج يفشل الخادم بإغلاق (FAIL-CLOSED) إذا:
#   - كان DB_USER هو `sa` (يجب حساب تطبيق مخصّص، وليس حساب مسؤول الخادم)
#   - كانت DB_PASSWORD فارغة أو قيمة ضعيفة/افتراضية معروفة (مثل 123)
# راجع SECURITY_FIXES.md (قسم مستخدم قاعدة البيانات) وخطوات التهيئة اليدوية.
DB_HOST=localhost
DB_INSTANCE=SQLEXPRESS

# ⚠️ `sa` أدناه للتطوير المحلي فقط — الإنتاج يُرفض مع `sa`.
DB_USER=sa
# ⚠️ القيمة 123 للتطوير المحلي فقط — الإنتاج يرفضها (كلمة مرور مخصّصة قوية إلزامية).
DB_PASSWORD=123
DB_NAME=DormMaster

# مطلوب فقط لتهيئة حاوية SQL Server في docker-compose (تهيئة الحاوية، وليس
# بيانات اعتماد التطبيق). لا توجد قيمة افتراضية — Compose يفشل إذا لم تُضبط.
# MSSQL_SA_PASSWORD=

# ⚠️ القيمة التالية مرفوضة عن قصد عند بدء الخادم (FAIL-CLOSED) — لا تستخدمها.
# للإنتاج: ولّد مفتاحاً عشوائياً قوياً (64 بايت على الأقل) وضعه في مخزن أسرار الإنتاج:
#   openssl rand -hex 64
JWT_SECRET=super-secret-key-change-me-in-production

# NODE_ENV: القيمة `development` أدناه للتطوير المحلي فقط.
# ⚠️ نشر الإنتاج يفرض NODE_ENV=production عبر docker-compose.yml (مفتاح
# `environment` يتجاوز `env_file`)، لذلك لا يمكن لـ .env تخفيضه إلى development.
# لا تعتمد على نسخ هذا الملف مباشرةً للنشر — استخدم مخزن أسرار الإنتاج.
NODE_ENV=development

# ==== Seed Admin (سكربت scripts/seed-admin.ts) ====
# ⚠️ لا توجد كلمة مرور افتراضية إطلاقاً — السكربت يفشل بآمان (FAIL-CLOSED)
# إذا لم تُضبط كلمة مرور قوية (12 حرفاً على الأقل) أو إذا كانت قيمة افتراضية معروفة.
# في الإنتاج يتطلب موافقة صريحة: SEED_ADMIN_ALLOW_PRODUCTION=true
# SEED_ADMIN_EMAIL=admin@sakani.com
# SEED_ADMIN_PASSWORD=replace-with-a-strong-42-char-secret
# SEED_ADMIN_ALLOW_PRODUCTION=false
ENCRYPTION_KEY=your-32-character-encryption-key-here

# باسورد افتراضي للمستخدمين الجدد (لو مجاش من المستخدم)
# ⚠️ غيّر هذه القيمة فوراً في الإنتاج - يجب أن تكون 8 أحرف على الأقل
DEFAULT_USER_PASSWORD=Sakani@2026#ChangeMe

# توكن الإعداد الأولي — مطلوب في الإنتاج (NODE_ENV=production) لفتح register على seep أول فجوة فقط.
# لو مش مضبوط، التسجيل المفتوح مقفول تماماً. يمرر في الهيدر: X-Setup-Token
# SETUP_REGISTRATION_TOKEN=change-me-when-you-go-live

# YouTube Data API Key (لعرض معلومات الفيديو تلقائياً)
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE

# ==== Security enhancements ====

# فرض HTTPS (يحتاج وكيل عكسي يضبط X-Forwarded-Proto)
ENFORCE_HTTPS=false

# Sentry monitoring (ياريت تفعّله في الإنتاج)
# SENTRY_DSN=https://your-dsn@oXXXX.ingest.us.sentry.io/XXXXXX
# SENTRY_TRACES_SAMPLE_RATE=0.1

# مصدر CORS المسموح به
CORS_ORIGIN=http://localhost:5173

# CSRF: في الإنتاج التساهل مع الطلبات المحلية (localhost/192.168) مقفول تماماً.
# لو محتاج تسمح بطلبات من شبكة محلية في الإنتاج، فعّل ده بمسؤوليتك:
# CSRF_ALLOW_LOCAL=true
